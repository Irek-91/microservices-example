# Service API Configuration
SERVICE_API_PORT=3000
GRPC_PORT=5001

# Service Worker Configuration
SERVICE_WORKER_PORT=3001
WORKER_GRPC_PORT=5002

# Zookeeper
ZOOKEEPER_PORT=2181

# Kafka Configuration
KAFKA_BROKER=localhost:9092
KAFKA_CLIENT_ID=nestjs-microservices
KAFKA_GROUP_ID=service-worker-group

# Service Communication
# URL для service-api для подключения к service-worker через gRPC
WORKER_GRPC_URL=localhost:5002

# Database Configuration - Service API
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=api_db

# Database Configuration - Service Worker
DB_WORKER_HOST=localhost
DB_WORKER_PORT=5433
DB_WORKER_USERNAME=postgres
DB_WORKER_PASSWORD=postgres
DB_WORKER_DATABASE=worker_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
IDEMPOTENCY_TTL_SECONDS=86400

# Docker Compose Configuration
ZOOKEEPER_PORT=2181
KAFKA_PORT=9092
KAFKA_JMX_PORT=9101

# Environment
NODE_ENV=development